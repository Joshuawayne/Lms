LMS_ENVIRONMENT=development
LMS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Copy a PostgreSQL session-pooler or direct connection URL from Supabase.
# Keep blank until the database has been configured. URI-encode the password.
# Only the FastAPI process reads this value.
LMS_DATABASE_URL=

# Path to the Supabase database CA certificate, downloaded from your project.
# Example on Windows: C:/LearningManagementSystem/.certs/supabase-ca.crt
LMS_DATABASE_SSLROOTCERT=

# Connection used ONLY by scripts/db_tools.py apply-migration (schema owner/maintenance).
# The runtime API must never use this URL.
LMS_MIGRATION_DATABASE_URL=

# Native database tests. There is NO fallback to LMS_DATABASE_URL.
# LMS_TEST_DATABASE_URL must name a dedicated database called lms_test or lms_test_<suffix>
# (created by `scripts/db_tools.py create-test-db`); LMS_TEST_MAINTENANCE_DATABASE_URL is a
# privileged login on the SAME server used to create it and to write/clean fixtures.
# Example: postgresql://postgres:<password>@127.0.0.1:5433/lms_test
LMS_TEST_DATABASE_URL=
LMS_TEST_MAINTENANCE_DATABASE_URL=

# Public application-submission protections (defaults shown). Counters are per worker
# process; a reverse proxy/WAF supplies the authoritative limit in multi-worker deployments.
# Set the rate limit to 0 to disable the in-process limiter when the edge enforces it.
# LMS_SUBMISSION_RATE_LIMIT=10
# LMS_SUBMISSION_RATE_WINDOW_SECONDS=60
# LMS_MAX_REQUEST_BODY_BYTES=16384
