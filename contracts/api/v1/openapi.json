        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "ProgramListResponse",
        "type": "object"
      },
      "ProgramStatus": {
        "description": "Publication lifecycle of a program.\n\nOnly 'published' programs are visible in public listings.",
        "enum": [
          "draft",
          "published",
          "archived"
        ],
        "title": "ProgramStatus",
        "type": "string"
      },
      "ProgramSummaryResponse": {
        "description": "Brief public overview of a published program.",
        "properties": {
          "applications_close_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applications Close At"
          },
          "applications_enabled": {
            "title": "Applications Enabled",
            "type": "boolean"
          },
          "applications_open_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applications Open At"
          },
          "delivery": {
            "$ref": "#/components/schemas/ProgramDelivery"
          },
          "display_order": {
            "title": "Display Order",
            "type": "integer"
          },
          "ends_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends On"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "max_age_years": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Age Years"
          },
          "max_enrolments": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Enrolments"
          },
          "min_age_years": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Age Years"
          },
          "pathway": {
            "$ref": "#/components/schemas/Pathway"
          },
          "slug": {
            "description": "URL slug (1-100 lowercase alphanumeric characters with hyphens).",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,98}[a-z0-9])?$",
            "title": "Slug",
            "type": "string"
