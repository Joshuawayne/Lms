    "/api/v1/programs": {
      "get": {
        "description": "Browse the catalogue of published learning programs.",
        "operationId": "list_programs_api_v1_programs_get",
        "parameters": [
          {
            "description": "Filter by learning pathway",
            "in": "query",
            "name": "pathway",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Pathway"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by learning pathway",
              "title": "Pathway"
            }
          },
          {
            "description": "Page number for pagination",
            "in": "query",
            "name": "page",
            "required": false,
