{
  "components": {
    "schemas": {
      "ApplicationReceiptResponse": {
        "description": "Minimal receipt returned to the guardian after submission.\n\nExcludes personal data from replay-query output in accordance with\nleast-privilege database permissions.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_retry": {
            "description": "True if this response was returned from an earlier identical submission.",
            "title": "Is Retry",
            "type": "boolean"
          },
          "program_id": {
            "format": "uuid",
            "title": "Program Id",
            "type": "string"
          },
          "reference": {
            "description": "Unique, human-friendly application tracking reference.",
            "title": "Reference",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "reference",
          "program_id",
          "status",
          "submitted_at",
          "is_retry"
        ],
        "title": "ApplicationReceiptResponse",
        "type": "object"
      },
      "ApplicationStatus": {
        "description": "Lifecycle of an enrolment application.\n\nApplications start as 'submitted' and move through review.\nAn application must not automatically create an approved enrolment.",
        "enum": [
          "submitted",
          "under_review",
          "approved",
          "rejected",
          "withdrawn"
        ],
        "title": "ApplicationStatus",
        "type": "string"
      },
      "GuardianRelationship": {
        "description": "The applicant's relationship to the learner.",
        "enum": [
          "parent",
          "guardian",
          "grandparent",
          "sibling",
          "other"
        ],
        "title": "GuardianRelationship",
        "type": "string"
      },
      "LivenessResponse": {
        "properties": {
          "service": {
            "const": "jjenga-lms-api",
            "default": "jjenga-lms-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "default": "0.1.0",
            "title": "Version",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "Pathway": {
        "description": "The three learning pathway categories offered by Jjenga Code.",
        "enum": [
          "school_term",
          "saturday_club",
          "holiday"
        ],
        "title": "Pathway",
        "type": "string"
      },
      "ProgramDelivery": {
        "description": "How a program is delivered to learners.",
        "enum": [
          "in_person",
          "online",
          "hybrid"
        ],
        "title": "ProgramDelivery",
        "type": "string"
      },
      "ProgramDetailResponse": {
        "description": "Full public details of a published program including rich description.",
        "properties": {
          "applications_close_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applications Close At"
          },
          "applications_enabled": {
            "title": "Applications Enabled",
            "type": "boolean"
          },
          "applications_open_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applications Open At"
          },
          "delivery": {
            "$ref": "#/components/schemas/ProgramDelivery"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "display_order": {
            "title": "Display Order",
            "type": "integer"
          },
          "ends_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends On"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "max_age_years": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Age Years"
          },
          "max_enrolments": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Enrolments"
          },
          "min_age_years": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Age Years"
          },
          "pathway": {
            "$ref": "#/components/schemas/Pathway"
          },
          "slug": {
            "description": "URL slug (1-100 lowercase alphanumeric characters with hyphens).",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,98}[a-z0-9])?$",
            "title": "Slug",
            "type": "string"
          },
          "starts_on": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts On"
          },
          "status": {
            "$ref": "#/components/schemas/ProgramStatus"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "pathway",
          "title",
          "slug",
          "summary",
          "delivery",
          "status",
          "applications_enabled",
          "applications_open_at",
          "applications_close_at",
          "starts_on",
          "ends_on",
          "max_enrolments",
          "min_age_years",
          "max_age_years",
          "display_order",
          "description"
        ],
        "title": "ProgramDetailResponse",
        "type": "object"
      },
      "ProgramListResponse": {
        "description": "Paginated collection of published programs.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProgramSummaryResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "total_pages": {
            "title": "Total Pages",
            "type": "integer"
          }
