      "ReadinessResponse": {
        "properties": {
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SubmitApplicationRequest": {
        "additionalProperties": false,
        "description": "Applicant payload for submitting an enrolment application.\n\nUnknown properties (for example a client trying to send ``status`` or\n``reviewed_at``) are rejected rather than silently discarded.",
        "properties": {
          "declaration_accepted": {
            "description": "Must be true to acknowledge and accept the applicant declaration.",
            "title": "Declaration Accepted",
            "type": "boolean"
          },
          "declaration_version": {
            "default": 1,
            "description": "Positive version number of the declaration text agreed to.",
            "exclusiveMinimum": 0.0,
            "title": "Declaration Version",
            "type": "integer"
          },
          "guardian_email": {
            "description": "Contact email address for application correspondence.",
            "maxLength": 254,
            "minLength": 5,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Guardian Email",
            "type": "string"
          },
          "guardian_name": {
            "description": "Full name of the parent or guardian.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Guardian Name",
            "type": "string"
          },
          "guardian_phone": {
            "anyOf": [
              {
                "maxLength": 30,
                "minLength": 5,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional contact telephone number.",
            "title": "Guardian Phone"
          },
          "guardian_relationship": {
            "$ref": "#/components/schemas/GuardianRelationship",
            "description": "Relationship of the applicant to the learner."
          },
          "idempotency_key": {
            "description": "Client-generated UUID to ensure submission idempotency.",
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          },
          "learner_age_years": {
            "description": "Age of the learner in completed years, as a whole number. Program eligibility is checked separately against the program's own age range.",
            "maximum": 99.0,
            "minimum": 1.0,
            "title": "Learner Age Years",
            "type": "integer"
          },
          "learner_name": {
            "description": "Full name of the learner.",
            "maxLength": 200,
            "minLength": 1,
            "title": "Learner Name",
            "type": "string"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional additional context or special learning requirements.",
            "title": "Notes"
          }
        },
        "required": [
          "idempotency_key",
          "guardian_name",
          "guardian_email",
          "guardian_relationship",
          "learner_name",
          "learner_age_years",
          "declaration_accepted"
        ],
        "title": "SubmitApplicationRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Core catalogue, programs and enrolment applications.",
    "title": "Jjenga Code LMS API",
    "version": "0.1.0"
  },
